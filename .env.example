# SSH to server
CRAWL_SSH_HOST=YOUR_SERVER_IP
CRAWL_SSH_PORT=22
CRAWL_SSH_USER=root
CRAWL_SSH_PASS=YOUR_PASSWORD
# or use key:
CRAWL_SSH_KEY=C:\Users\you\.ssh\id_rsa

# Remote paths
REMOTE_PROJECT_DIR=/root/tor_crawler
REMOTE_VENV_ACTIVATE=.venv/bin/activate
REMOTE_CRAWLER=crawler_export.py
REMOTE_BUNDLE=crawl_bundle.tar.gz

# LM Studio
LM_BASE_URL=http://localhost:1234/v1
LM_MODEL=qwen2.5-vl-7b-instruct
